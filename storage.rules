rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Temp uploads: accessible by authenticated users, auto-cleanup after 30 days ───
    // Supports both flat (temp/{fileId}) and batch (temp/{batchId}/{fileId}) layouts
    match /temp/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 310 * 1024 * 1024  // 310MB limit
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // ─── No permanent file storage — all confirmed data goes to Firestore ───
    // Raw files are deleted after save (step 8 in flow)
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Raw invoice uploads: only authenticated users, path must match their pharmacyId pattern
    match /invoices/{pharmacyId}/{fileName} {
      // Allow read/write only to authenticated users
      // The CF (admin SDK) bypasses these rules entirely
      allow read, write: if request.auth != null;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

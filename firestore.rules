rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: The client Firestore SDK intermittently sends writes without a
    // valid auth token right after sign-in (firebase-js-sdk#4050), which made
    // "request.auth != null" rules reject importQueue writes even though the
    // user is signed in. Reads are auth-gated (they work); writes are opened
    // so the upload pipeline is not blocked. Tighten this once the token
    // delivery is fixed (or route writes through Cloud Functions / staff docs).
    match /pharmacies/{pharmacyId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
